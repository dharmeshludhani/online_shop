pipeline{
    
    agent {label "Dev"};
    
    stages{
        stage("code Clone"){
            steps{
                git url:"https://github.com/dharmeshludhani/online_shop.git", branch: "jenkins"
            }
        }
        stage("Code Build"){
            steps{
               sh "docker build -t online-shop-app-new . "
            }
        }
        stage("Testing Phase"){
            steps{
                echo "Data will be available soon"
            }
        }
        stage("Deployment"){
            steps{
                sh "docker compose down"
                sh "docker compose up -d --build onlineshop-app "
            }
        }
    
    }
}
